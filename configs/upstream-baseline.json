{
  "audio": {
    "allow_identical_target_and_reference": false,
    "internal_sample_rate": 44100,
    "max_length_seconds": 900.0,
    "metadata_policy": "drop",
    "temp_directory": "../artifacts/tmp"
  },
  "detection": {
    "clipping_peak": 1.0,
    "clipping_samples_threshold": 8,
    "limited_samples_threshold": 128,
    "near_silence_peak": 0.0001,
    "silence_peak": 1e-12
  },
  "edge_cases": {
    "create_output_directories": true,
    "existing_output": "error",
    "lossy_input": "warn",
    "mono_input": "warn",
    "more_than_two_channels": "error",
    "near_silence": "error",
    "non_finite_audio": "error",
    "sample_rate_conversion": "warn",
    "silence": "error"
  },
  "execution": {
    "dry_run": false,
    "engine": "upstream-matchering-2.0.6",
    "event_log_path": null,
    "job_id": null,
    "manifest_path": null,
    "max_workers": 1
  },
  "limiter": {
    "attack_filter_coefficient": -2.0,
    "attack_ms": 1.0,
    "external_command": [],
    "hold_filter_coefficient": 7.0,
    "hold_filter_order": 1,
    "hold_ms": 1.0,
    "kind": "hyrax",
    "peak_mode": "sample-peak",
    "release_filter_coefficient": 800.0,
    "release_filter_order": 1,
    "release_ms": 3000.0,
    "threshold_linear": 0.998138427734375,
    "true_peak_oversampling": 4
  },
  "matching": {
    "amount": 1.0,
    "fft_size": 4096,
    "lin_log_oversampling": 4,
    "loudness_metric": "matchering-loud-section-rms",
    "lowess_delta": 0.001,
    "lowess_fraction": 0.0375,
    "lowess_iterations": 0,
    "max_eq_gain_db": null,
    "max_piece_seconds": 15.0,
    "min_value": 1e-06,
    "rms_correction_steps": 4
  },
  "notes": "Faithful, fully expanded Matchering 2.0.6 compatibility profile.",
  "outputs": [
    {
      "dither": "none",
      "label": "distribution master",
      "mode": "limited",
      "path": "../artifacts/renders/mastered-24.wav",
      "subtype": "PCM_24"
    },
    {
      "dither": "none",
      "label": "normalized without limiter",
      "mode": "normalized-no-limiter",
      "path": "../artifacts/renders/matched-normalized-24.wav",
      "subtype": "PCM_24"
    },
    {
      "dither": "none",
      "label": "floating-point DAW handoff",
      "mode": "raw-float-no-limiter",
      "path": "../artifacts/renders/matched-raw-float.wav",
      "subtype": "FLOAT"
    }
  ],
  "preview": {
    "analysis_step_seconds": 5.0,
    "duration_seconds": 30.0,
    "enabled": true,
    "fade_coefficient": 8.0,
    "fade_seconds": 1.0,
    "result_path": "../artifacts/previews/result-preview.wav",
    "subtype": "PCM_16",
    "target_path": "../artifacts/previews/target-preview.wav"
  },
  "references": [
    {
      "frequency_weight": 1.0,
      "label": "primary reference",
      "level_weight": 1.0,
      "path": "../audio/reference.wav"
    }
  ],
  "schema_version": 1,
  "target": "../audio/target.wav"
}
