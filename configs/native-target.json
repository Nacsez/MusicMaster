{
  "audio": {
    "allow_identical_target_and_reference": false,
    "internal_sample_rate": 48000,
    "max_length_seconds": 1800.0,
    "metadata_policy": "copy-safe",
    "temp_directory": "../artifacts/tmp"
  },
  "detection": {
    "clipping_peak": 1.0,
    "clipping_samples_threshold": 8,
    "limited_samples_threshold": 128,
    "near_silence_peak": 0.0001,
    "silence_peak": 1e-12
  },
  "edge_cases": {
    "create_output_directories": true,
    "existing_output": "error",
    "lossy_input": "error",
    "mono_input": "warn",
    "more_than_two_channels": "error",
    "near_silence": "error",
    "non_finite_audio": "error",
    "sample_rate_conversion": "warn",
    "silence": "error"
  },
  "execution": {
    "dry_run": false,
    "engine": "music-mastering-tools-native",
    "event_log_path": "../artifacts/runs/native-target/events.jsonl",
    "job_id": null,
    "manifest_path": "../artifacts/runs/native-target/manifest.json",
    "max_workers": 1
  },
  "limiter": {
    "attack_filter_coefficient": -2.0,
    "attack_ms": 1.0,
    "external_command": [],
    "hold_filter_coefficient": 7.0,
    "hold_filter_order": 1,
    "hold_ms": 1.0,
    "kind": "hyrax",
    "peak_mode": "true-peak",
    "release_filter_coefficient": 800.0,
    "release_filter_order": 1,
    "release_ms": 1500.0,
    "threshold_linear": 0.8912509381337456,
    "true_peak_oversampling": 8
  },
  "matching": {
    "amount": 0.8,
    "fft_size": 8192,
    "lin_log_oversampling": 8,
    "loudness_metric": "ebu-r128-lufs",
    "lowess_delta": 0.001,
    "lowess_fraction": 0.0375,
    "lowess_iterations": 1,
    "max_eq_gain_db": 18.0,
    "max_piece_seconds": 20.0,
    "min_value": 1e-06,
    "rms_correction_steps": 4
  },
  "notes": "Intentional capability-rejection specimen for future native controls (partial amount, EBU R128, true peak, metadata copy, and dither). Use weighted-references.json for the current runnable native subset.",
  "outputs": [
    {
      "dither": "noise-shaped",
      "label": "true-peak distribution master",
      "mode": "limited",
      "path": "../artifacts/renders/native-mastered-24.wav",
      "subtype": "PCM_24"
    },
    {
      "dither": "none",
      "label": "floating-point DAW handoff",
      "mode": "raw-float-no-limiter",
      "path": "../artifacts/renders/native-raw-float.wav",
      "subtype": "FLOAT"
    }
  ],
  "preview": {
    "analysis_step_seconds": 5.0,
    "duration_seconds": 30.0,
    "enabled": true,
    "fade_coefficient": 8.0,
    "fade_seconds": 1.0,
    "result_path": "../artifacts/previews/native-result.wav",
    "subtype": "PCM_16",
    "target_path": "../artifacts/previews/native-target.wav"
  },
  "references": [
    {
      "frequency_weight": 0.75,
      "label": "tone reference",
      "level_weight": 0.25,
      "path": "../audio/reference-tone.wav"
    },
    {
      "frequency_weight": 0.25,
      "label": "level reference",
      "level_weight": 0.75,
      "path": "../audio/reference-level.wav"
    }
  ],
  "schema_version": 1,
  "target": "../audio/target.wav"
}
